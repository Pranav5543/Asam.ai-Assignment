# ==============================================================================
# Unified Environment Configuration Template (.env.example)
#
# QUICK START:
# 1. Copy this file to create your local .env file:
#    cp .env.example .env     (or in Windows: copy .env.example .env)
# 2. Paste your xAI Grok API key into GROK_API_KEY below.
# 3. All other values have working defaults and can be left as-is!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Grok (xAI) API Configuration
# ------------------------------------------------------------------------------
# Paste your xAI Grok API key here (from https://console.x.ai)
# Note: If no key is set, the system gracefully falls back to offline/template mode.
GROK_API_KEY=your_grok_api_key_here

# Grok API endpoint and model selection
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
MODEL=grok-2-latest

# ------------------------------------------------------------------------------
# 2. Problem 1: Agent Network Configuration (agent_network)
# ------------------------------------------------------------------------------
# SQLite database path:
# - Use ":memory:" for fast, in-memory ephemeral testing (default)
# - Or set to a file path like "agent_network.db" for persistent data across restarts
DB=:memory:

# Admin authorization key for verifying registered agents and signing webhooks
ADMIN_KEY=admin

# Server host & port for FastAPI / uvicorn app
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 3. Problem 2: Linux Hardware Q&A Configuration (hwqa)
# ------------------------------------------------------------------------------
# Default backend for hardware Q&A:
# - "offline" : Deterministic rule engine (fast, zero LLM, 100% local)
# - "grok"    : Cloud tool-calling via xAI Grok
# - "ollama"  : Local tool-calling via Ollama
HWQA_BACKEND=grok

# Local Ollama endpoint URL (only used if HWQA_BACKEND=ollama or --backend ollama)
OLLAMA=http://localhost:11434
